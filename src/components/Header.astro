---
import { SITE, NAV } from "../data/site";
import OnlineCount from "./OnlineCount.astro";
import CopyIpButton from "./CopyIpButton.astro";
---

<header
  class="sticky top-0 z-50 border-b border-ice/15 bg-night-900/90 backdrop-blur-[14px]"
>
  <div class="flex items-center justify-between gap-6 px-5 py-3 md:px-10">
    <a href="#top" class="flex items-center gap-2.5 text-white">
      <img
        src={SITE.logo}
        alt="Logo del servidor NewJeans"
        width="44"
        height="44"
        class="logo-njz h-11 w-auto"
      />
      <span class="text-[19px] font-extrabold tracking-[-.4px]">
        NewJeans<span class="text-ice">.lat</span>
      </span>
    </a>

    <nav
      class="hidden items-center gap-7 text-[13.5px] font-bold tracking-[1.1px] uppercase lg:flex"
    >
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="text-ink-300 transition-colors hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3.5">
      <OnlineCount class="hidden sm:flex" />
      <CopyIpButton />
    </div>
  </div>

  <nav
    class="flex gap-6 overflow-x-auto border-t border-ice/10 px-5 py-2.5 text-[13px] font-bold tracking-[1.1px] whitespace-nowrap uppercase lg:hidden"
  >
    {
      NAV.map((item) => (
        <a href={item.href} class="text-ink-300 transition-colors hover:text-white">
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
