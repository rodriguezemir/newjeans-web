---
import { SITE, NAV } from "../data/site";
import OnlineCount from "./OnlineCount.astro";
import CopyIpButton from "./CopyIpButton.astro";
---

<header
  class="sticky top-0 z-50 border-b border-red-500/15 bg-night-900/90 backdrop-blur-[14px]"
>
  <div class="flex items-center justify-between gap-6 px-5 py-3 md:px-10">
    <a href="#top" class="flex items-center gap-2.5 text-white">
      <img
        src={SITE.logo}
        alt="Logo del servidor NewJeans"
        width="44"
        height="44"
        class="logo-njz h-11 w-auto"
      />
      <span class="text-[19px] line-through font-extrabold tracking-[-.4px]">
        NewJeans<span class="text-red-500">.lat</span>
      </span>
    </a>

    <div class="flex items-center gap-3.5">
      <OnlineCount class="hidden sm:flex" />
    </div>
  </div>
</header>
