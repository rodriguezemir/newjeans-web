---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "flex items-center gap-2 rounded-full border border-red-400/25 bg-mint/7 px-3.5 py-2 text-[13px] font-bold",
    className,
  ]}
>
  <span class="size-2 animate-nj-pulse rounded-full bg-red-600"></span>
  <span class="font-mono text-red-600">Apagado</span>
</div>
