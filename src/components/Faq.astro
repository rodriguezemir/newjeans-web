---
import { FAQS } from "../data/faqs";
---

<section id="faq" class="bg-night-900 px-5 pt-5 pb-25 md:px-10">
  <div class="mx-auto max-w-[820px]">
    <div class="mb-8 text-center" data-reveal-heading>
      <p
        class="mb-3 text-[13px] font-extrabold tracking-[1.6px] text-ice uppercase"
      >
        FAQ
      </p>
      <h2
        class="text-[32px] font-black tracking-[-1.1px] md:text-[44px] md:tracking-[-1.6px]"
      >
        Preguntas frecuentes
      </h2>
    </div>

    <div class="flex flex-col gap-3">
      {
        FAQS.map((faq, i) => (
          <details
            name="faq"
            open={i === 0}
            data-reveal-card
            class="group rounded-2xl border border-white/8 bg-night-800 transition-colors hover:border-ice/35"
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 px-6.5 py-5.5 [&::-webkit-details-marker]:hidden">
              <h3 class="text-lg font-extrabold tracking-[-.4px]">{faq.q}</h3>
              <span
                aria-hidden="true"
                class="text-[22px] leading-none font-bold text-ice"
              >
                <span class="group-open:hidden">+</span>
                <span class="hidden group-open:inline">−</span>
              </span>
            </summary>
            <p class="max-w-[660px] px-6.5 pb-5.5 text-[15.5px] leading-[1.7] text-ink-400">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
