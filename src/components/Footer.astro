---
import { SITE } from "../data/site";

const COLUMNS = [
  {
    title: "Servidor",
    links: [
      { label: "Modalidades", href: "#modalidades" },
      { label: "Tops", href: "#tops" },
      { label: "Blog", href: "#blog" },
      { label: "Reglas", href: "#faq" },
    ],
  },
  {
    title: "Tienda",
    links: [
      { label: "Rangos", href: SITE.store },
      { label: "Cosméticos", href: SITE.store },
      { label: "Unban", href: SITE.store },
      { label: "Soporte de compras", href: SITE.store },
    ],
  },
  {
    title: "Comunidad",
    links: [
      { label: "Discord", href: SITE.discord },
      { label: "Postular a staff", href: SITE.discord },
      { label: "Reportar cheater", href: SITE.discord },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-ice/12 bg-night-950 px-5 pt-15 pb-10 md:px-10">
  <div
    class="mx-auto flex max-w-[1180px] flex-wrap justify-between gap-10"
  >
    <div class="flex max-w-[320px] flex-col gap-3.5">
      <img
        src={SITE.logo}
        alt="NewJeans"
        width="130"
        height="130"
        loading="lazy"
        class="logo-njz h-auto w-[130px]"
      />
      <p class="text-sm leading-relaxed text-ink-600">
        Servidor de Minecraft PvP para Latinoamérica. IP:{" "}
        <strong class="font-semibold text-ink-300">{SITE.ip}</strong>
      </p>
      <p class="text-[12.5px] leading-relaxed text-ink-700">
        No es un producto oficial de Minecraft. No está aprobado ni asociado con
        Mojang o Microsoft.
      </p>
    </div>

    <div class="flex flex-wrap gap-x-15 gap-y-8">
      {
        COLUMNS.map((column) => (
          <div class="flex flex-col gap-2.75">
            <p class="mb-1 text-xs font-extrabold tracking-[1.4px] text-ink-500 uppercase">
              {column.title}
            </p>
            {column.links.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith("#") ? undefined : "_blank"}
                rel={link.href.startsWith("#") ? undefined : "noopener"}
                class="text-[14.5px] text-ink-300 transition-colors hover:text-white"
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="mx-auto mt-9 max-w-[1180px] border-t border-white/6 pt-5.5 text-[12.5px] text-ink-700"
  >
    © {year} NewJeans · {SITE.ip} · Hecho en LatAm
  </div>
</footer>
